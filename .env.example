# ============================================================================
# WAFRA vitrine — environment example. Copy to .env for local development.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

# --- Public origin ----------------------------------------------------------
APP_URL=http://localhost:3000

# --- Contact form email delivery -------------------------------------------
# disabled | resend | smtp
EMAIL_PROVIDER=resend
# Verified sender. On Resend, the domain must be verified first.
EMAIL_FROM=WAFRA <no-reply@your-domain.com>
# Where new requests are delivered.
CONTACT_EMAIL=contact@your-domain.com

# Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=

# Alternative: SMTP (set EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Public (browser-readable) ---------------------------------------------
# International digits without "+", e.g. 21612345678
NEXT_PUBLIC_WAFRA_WHATSAPP_NUMBER=
